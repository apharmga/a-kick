rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOp() { return signedIn() && request.auth.token.email == 'apharmga@gmail.com' && request.auth.token.email_verified == true; }
    // 추천 코드: 있는 코드여야 하고, 내 코드로 내 팀을 추천할 수 없음
    function validRef(code) {
      return code is string && exists(/databases/$(database)/documents/refs/$(code))
        && get(/databases/$(database)/documents/refs/$(code)).data.uid != request.auth.uid;
    }

    // 내 팀 목록 (본인만)
    match /me/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 오류 기록: 로그인한 사람은 남기기만, 보기·지우기는 운영자만
    // 업적: 내 기록은 나만
    match /ach/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 추천 코드: 누구나 확인 가능, 만들기는 본인 것만. 구장 코드(venue)는 운영자만
    match /refs/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z0-9]{4,12}$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at is int
        && (request.resource.data.keys().hasOnly(['uid', 'at'])
          || (isOp() && request.resource.data.keys().hasOnly(['uid', 'at', 'venue'])
            && request.resource.data.venue is string && request.resource.data.venue.size() <= 20));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /errlog/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['at', 'uid', 'cid', 'page', 'msg', 'stack', 'ua', 'ver'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300;
      allow read, delete: if signedIn() && request.auth.token.email == 'apharmga@gmail.com' && request.auth.token.email_verified == true;
    }

    match /clubs/{cid} {
      function club() { return get(/databases/$(database)/documents/clubs/$(cid)).data; }
      function isOwner() { return signedIn() && club().owner == request.auth.uid; }
      function myMid() { return get(/databases/$(database)/documents/clubs/$(cid)/users/$(request.auth.uid)).data.mid; }
      function isMember() { return signedIn() && exists(/databases/$(database)/documents/clubs/$(cid)/users/$(request.auth.uid)); }

      // 팀 이름·주인: 링크 받은 사람이면 읽기, 만든 사람만 수정
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'owner', 'created', 'refBy'])
        && (!('refBy' in request.resource.data) || validRef(request.resource.data.refBy));
      // 추천 코드는 비어 있을 때 한 번만 넣을 수 있고, 넣은 뒤엔 못 바꿈
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && (request.resource.data.get('refBy', '') == resource.data.get('refBy', '')
          || (resource.data.get('refBy', '') == '' && validRef(request.resource.data.refBy)));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // 팀 안의 모든 데이터(거래·실력 점수·설정): 만든 사람(관리자)만
      match /{col}/{id} {
        allow read, write: if isOwner();
      }
      // 회원 화면 요약 (실력 점수·거래 상세 없음): 링크 받은 사람
      // 회원 화면 요약: 승인된 회원만
      match /pub/{id} {
        allow read: if isMember();
      }
      // 가입 신청: 본인 것만 쓰고 읽기 (승인·거절은 관리자)
      match /requests/{uid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'email', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.email == request.auth.token.email;
      }
      // 이름-계정 연결과 회원 승인은 관리자만 (위 isOwner 규칙). 본인 것만 읽기
      // (탈퇴: 본인 연결은 본인이 지울 수 있음)
      match /claims/{mid} {
        allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
      match /users/{uid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
      }
      // 골·도움 기록: 회원 누구나 넣기, 지우기는 넣은 사람(관리자는 전부)
      match /goals/{id} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['gid', 'scorer', 'assist', 'by', 'byName', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.scorer is string && request.resource.data.scorer.size() > 0 && request.resource.data.scorer.size() <= 30
          && request.resource.data.assist is string && request.resource.data.assist.size() <= 30;
        allow delete: if isMember() && resource.data.by == request.auth.uid;
      }
      // 참석 투표: 이름을 고른 회원이 본인 이름으로만
      // 투표·공지: 관리자가 만들고 회원은 읽기만
      match /polls/{id} {
        allow read: if isMember();
      }
      // 투표 참여: 내 이름으로만
      match /pollvotes/{id} {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['pid', 'mid', 'name', 'picks', 'add', 'uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.mid == myMid()
          && request.resource.data.picks is list && request.resource.data.picks.size() <= 10
          && request.resource.data.add is string && request.resource.data.add.size() <= 20
          && id == request.resource.data.pid + '__' + request.resource.data.mid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
      // 건의함: 회원은 보내기만, 읽기는 관리자(본인 것은 본인도)
      // 익명 투표: 열쇠(anonmark)는 본인만 보고, 투표(anonvotes)엔 이름·계정이 없음. 1인 1표
      match /anonmark/{id} {
        allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['pid', 'uid', 'key'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.key is string && request.resource.data.key.size() == 32
          && id == request.resource.data.pid + '__' + request.auth.uid;
      }
      match /anonvotes/{id} {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['pid', 'picks', 'add', 'at'])
          && request.resource.data.picks is list && request.resource.data.picks.size() <= 10
          && request.resource.data.add is string && request.resource.data.add.size() <= 20
          && id == request.resource.data.pid + '__' + getAfter(/databases/$(database)/documents/clubs/$(cid)/anonmark/$(request.resource.data.pid + '__' + request.auth.uid)).data.key;
        allow delete: if signedIn() && id == resource.data.pid + '__' + get(/databases/$(database)/documents/clubs/$(cid)/anonmark/$(resource.data.pid + '__' + request.auth.uid)).data.key;
      }
      // 하이라이트: 관리자가 올리고(위 isOwner 규칙) 회원은 보기만
      match /videos/{id} {
        allow read: if isMember();
      }
      // 하이라이트 댓글: 회원이 본인 이름으로 쓰고, 본인 것만 지움 (관리자는 전부)
      match /vcomments/{id} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['vid', 'text', 'name', 'mid', 'uid', 'at', 'pid'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.mid == myMid()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
      // 알림 받기 설정: 본인 것만 (발송은 서버가 함)
      match /push/{uid} {
        allow read, write: if isMember() && request.auth.uid == uid;
      }
      // 선수 정보(등번호·포지션): 회원이 본인 것만
      match /profiles/{mid} {
        allow read: if isMember();
        allow write: if isMember() && mid == myMid()
          && (request.resource == null || (request.resource.data.keys().hasOnly(['num', 'pos', 'uid', 'at', 'ach', 'plat', 'xp', 'lv'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.num is int && request.resource.data.num >= 0 && request.resource.data.num <= 99
            && request.resource.data.pos is list && request.resource.data.pos.size() <= 2));
      }
      // 가위바위보: 본인 하루 기록 1개 (하루 5판, 한 판 최대 100이라 하루 ±500 안)
      match /rps/{id} {
        allow read: if isMember();
        allow write: if isMember() && id == request.auth.uid + '_' + request.resource.data.date
          && request.resource.data.keys().hasOnly(['uid', 'mid', 'name', 'date', 'n', 'w', 'l', 'net', 'at'])
          && request.resource.data.uid == request.auth.uid && request.resource.data.mid == myMid()
          && request.resource.data.date is string && request.resource.data.date.size() == 8
          && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 5
          && request.resource.data.net is int && request.resource.data.net >= -500 && request.resource.data.net <= 500;
      }
      // 다음 경기 날씨: 회원 누구나 새로 받아와 공유
      match /wx/{gid} {
        allow read: if isMember();
        allow write: if isMember()
          && request.resource.data.keys().hasOnly(['gid', 'date', 'time', 't', 'pop', 'pr', 'mx', 'st', 'code', 'wind', 'at'])
          && request.resource.data.gid == gid && request.resource.data.at is int;
      }
      match /suggest/{id} {
        allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['text', 'name', 'anon', 'uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
      }
      match /votes/{id} {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['gid', 'mid', 'name', 'v', 'uid', 'at'])
          && request.resource.data.v in ['참석', '불참']
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.mid == myMid()
          && id == request.resource.data.gid + '__' + request.resource.data.mid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
